# The radio app's own settings (buttons_led's, with the radio on). Everything about the board - flash, PSRAM,
# cache, the console - arrives from kbsp's sdkconfig.board, which
# CMakeLists.txt fetches and reads first. Do not copy any of it here.

CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="managed_components/kodediy__kbsp/partitions.csv"

# The role AO_Boot plays, and the safety property the slot model rests on:
# this firmware never writes otadata, so any reset returns to kodeOS.
CONFIG_KODEOS_BOOT_ROLE_APP=y

# Kept, so there is somewhere to watch this AO from on the bench.
CONFIG_KODEOS_CONSOLE=y

# Nothing here draws, so the panel's shadow copy (402 KB of PSRAM, written by
# every flush) would only ever hold a blank glass. The mirror that streams it
# depends on it and goes with it.
CONFIG_KODEOS_SCREENSHOT=n

# The radio and WiFi, as kode-sdk's network example has them: AO_Radio brings
# the C5 up over esp-hosted and joins the network (the simulator's C5 is an
# esp-emu of its own); the sockets are lwIP's, below AO_Net.
CONFIG_KODEOS_RADIO=y
CONFIG_KODEOS_WIFI=y
CONFIG_KODEOS_NET=y

# The SDK's own log lines are compiled in at every level, and most of them are
# INFO: a shipped app that will never print them can compile them away, which
# is well over a hundred kB of format strings. Left at everything here, because
# an example is run on the bench first (components/klog/Kconfig says what goes).
# CONFIG_KLOG_MAXIMUM_LEVEL_WARN=y
